# Copy this file to .env and fill it in. Never commit .env.
OPENAI_API_KEY=sk-...

# Optional
# OPENAI_MODEL=gpt-5.4-mini        # model that explains slides
# OPENAI_CHECK_MODEL=gpt-5.4       # model that reviews explanations
# APP_PASSWORD=choose-a-password   # protects a hosted copy (username: demo)
# NOTION_TOKEN=ntn_...             # for "Export to Notion"
# NOTION_PARENT_PAGE=https://www.notion.so/...
# MAX_PAGES=60
# MOCK_LLM=1                       # offline mode: no API calls, fake explanations
